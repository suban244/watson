# Single ingress for the Watson dashboard.
# Public TLS is terminated at Cloudflare's edge; cloudflared forwards plain HTTP
# to this container over the internal docker network, so Caddy speaks HTTP on :80
# and publishes no host port.
:80 {
	# API calls (relative /api/v1 from the browser, see src/lib/api.ts) go to
	# the backend container on the internal `back` network.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else is the static SvelteKit build. try_files falls back to
	# index.html so client-side routes (/transactions, /analytics, ...) resolve.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip
}
